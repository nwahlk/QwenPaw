# === M1-QA 投研问答助手 环境变量 ===

# 数据存储目录（默认 ./data）
# DATA_DIR=./data

# CoPaw 桥接配置
# IRA_COPAW_APP_URL=http://localhost:8088/api/v1/chat
# IRA_COPAW_API_KEY=your_copaw_api_key

# 百炼 DashScope 配置
# DASHSCOPE_API_KEY=your_dashscope_api_key
# DASHSCOPE_MODEL=qwen-turbo

# Flask 配置
# FLASK_PORT=5000
# FLASK_DEBUG=false
